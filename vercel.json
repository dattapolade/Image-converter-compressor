{
    "version": 2,
    "builds": [
      {
        "src": "src/app.js",
        "use": "@vercel/node",
        "config": {
          "nodeVersion": "18.x"
        }
      }
    ],
    "routes": [
      {
        "handle": "filesystem"
      },
      {
        "src": "/(.*)",
        "dest": "src/app.js"
      }
    ],
    "env": {
      "NODE_ENV": "production"
    }
  }
  